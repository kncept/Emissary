diff --git a/src/runner/test-context.ts b/src/runner/test-context.ts
index a554e84..44971a4 100644
--- a/src/runner/test-context.ts
+++ b/src/runner/test-context.ts
@@ -37,6 +37,25 @@ export class TestContext {
   /** Second client for secondary account (if configured) */
   public secondaryClient?: JmapClient;
 
+  /** Whether the advertised profile allows nested mailboxes (maxMailboxDepth > 1). */
+  public supportsNestedMailboxes: boolean = true;
+
+  /** Whether the advertised profile allows an Email in more than one Mailbox. */
+  public supportsMultipleMailboxes: boolean = true;
+
+  /** Sort properties advertised in the mail account capability. */
+  public supportedSortProperties: Set<string> = new Set(["receivedAt"]);
+
+  /** Whether delayed submission is supported (maxDelayedSend != 0). */
+  public supportsDelayedSend: boolean = true;
+
+  supportsSort(...properties: string[]): true | string {
+    const missing = properties.filter((p) => !this.supportedSortProperties.has(p));
+    return missing.length === 0
+      ? true
+      : `emailQuerySortOptions does not advertise ${missing.join(", ")}`;
+  }
+
   /** Smee.io channel for push subscription tests (undefined if smee.io is unreachable) */
   public smeeChannel?: SmeeChannel;
 
diff --git a/src/runner/test-runner.ts b/src/runner/test-runner.ts
index 822e103..659bf33 100644
--- a/src/runner/test-runner.ts
+++ b/src/runner/test-runner.ts
@@ -100,6 +100,36 @@ export async function runTests(options: RunOptions): Promise<TestResult[]> {
   });
 
   const ctx = new TestContext(client, config);
+  const accountCaps = client.session.accounts[client.accountId]?.accountCapabilities ?? {};
+  const mailCaps = accountCaps["urn:ietf:params:jmap:mail"] ?? client.session.capabilities["urn:ietf:params:jmap:mail"] ?? {};
+  const maxDepth = (mailCaps as Record<string, unknown>)["maxMailboxDepth"];
+  ctx.supportsNestedMailboxes = maxDepth == null || Number(maxDepth) > 1;
+  const maxMailboxes = (mailCaps as Record<string, unknown>)["maxMailboxesPerEmail"];
+  ctx.supportsMultipleMailboxes = maxMailboxes == null || Number(maxMailboxes) > 1;
+  const sortOptions = (mailCaps as Record<string, unknown>)["emailQuerySortOptions"];
+  if (Array.isArray(sortOptions)) {
+    ctx.supportedSortProperties = new Set(
+      sortOptions.map((option) =>
+        typeof option === "string" ? option : String((option as { property?: string }).property ?? "")
+      )
+    );
+  }
+  const submissionCaps =
+    accountCaps["urn:ietf:params:jmap:submission"] ??
+    client.session.capabilities["urn:ietf:params:jmap:submission"] ??
+    {};
+  const maxDelayed = (submissionCaps as Record<string, unknown>)["maxDelayedSend"];
+  ctx.supportsDelayedSend = maxDelayed == null || Number(maxDelayed) !== 0;
+  if (!ctx.supportsNestedMailboxes || !ctx.supportsMultipleMailboxes ||
+      ctx.supportedSortProperties.size < 2 || !ctx.supportsDelayedSend) {
+    process.stderr.write(
+      "\n⚠ Applying advertised profile skips: " +
+      `nestedMailboxes=${ctx.supportsNestedMailboxes}, ` +
+      `multipleMailboxes=${ctx.supportsMultipleMailboxes}, ` +
+      `sorts=${[...ctx.supportedSortProperties].join(",") || "none"}, ` +
+      `delayedSend=${ctx.supportsDelayedSend}\n`
+    );
+  }
   if (crossAccountId) {
     ctx.crossAccountId = crossAccountId;
   }
